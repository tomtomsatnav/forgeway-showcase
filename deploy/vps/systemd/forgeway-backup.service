# Nightly encrypted database backup. Install: see deploy/vps/README.md ("Timers").
[Unit]
Description=Forgeway database backup (pg_dump, age-encrypted, rotated)
Requires=docker.service
After=docker.service
OnFailure=forgeway-alert@%n.service

[Service]
Type=oneshot
User=forgeway
Group=forgeway
StateDirectory=forgeway
Environment=HOME=/var/lib/forgeway
ExecStart=/srv/forgeway/deploy/vps/backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/forgeway
