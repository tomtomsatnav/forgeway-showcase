# Re-applies every live subscription from Stripe, in case a webhook was lost
# (docs/plans/billing.md). Install: see deploy/vps/README.md ("Timers").
[Unit]
Description=Forgeway billing reconciliation with Stripe
Requires=docker.service
After=docker.service
OnFailure=forgeway-alert@%n.service

[Service]
Type=oneshot
User=forgeway
Group=forgeway
StateDirectory=forgeway
Environment=HOME=/var/lib/forgeway
ExecStart=/srv/forgeway/deploy/vps/reconcile.sh
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
