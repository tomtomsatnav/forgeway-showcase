# Settings for the Forgeway operations scripts (deploy, backup, restore, health check).
# Copy to /etc/forgeway/ops.env (owner root, group forgeway, mode 640). Every value is
# optional unless marked REQUIRED; the defaults suit the VPS layout in deploy/vps/README.md.
# Never put the age PRIVATE key here.

# Where the repository and its .env.production live, and where Caddy reaches the site.
# FORGEWAY_DIR=/srv/forgeway
# FORGEWAY_SITE=http://127.0.0.1:8090

# --- Alerts -----------------------------------------------------------------------------
# A webhook for alerts: an ntfy topic URL (https://ntfy.sh/<long-random-topic>), a Discord
# webhook or a Slack incoming webhook. Empty: alerts go to the journal only
# (journalctl -t forgeway-alert).
ALERT_WEBHOOK_URL=
# A dead man's switch pinged after every passing health check (for example a healthchecks.io
# check URL), so something outside the VPS notices when the VPS itself stops.
DEADMAN_URL=

# --- Health check thresholds --------------------------------------------------------------
# WORKER_MAX_AGE_S=300
# QUEUE_MAX_AGE_S=300
# DISK_MAX_PERCENT=85
# DISK_PATHS="/ /var/lib/docker"
# REALERT_AFTER_S=21600

# --- Backups ------------------------------------------------------------------------------
# REQUIRED for backups: one or more age PUBLIC keys (age1...), space-separated. Keep the
# matching private key off this server (password manager, plus an offline copy).
AGE_RECIPIENTS=
# BACKUP_DIR=/var/backups/forgeway
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# WEEKLY_ON=7
# Off-site copies: an rclone remote and bucket, e.g. r2:forgeway-backups. Empty: backups stay
# on this VPS only (a known risk until a bucket exists).
RCLONE_REMOTE=
# RCLONE_CONFIG=/etc/forgeway/rclone.conf

# --- Deploys ------------------------------------------------------------------------------
# KEEP_RELEASES=3
# KEEP_PREDEPLOY_DUMPS=3
