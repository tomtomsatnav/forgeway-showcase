# Copy to .env for local overrides. Every setting has a safe development default.
LATTICE_DATABASE_URL=postgresql+psycopg://lattice:lattice@localhost:5432/lattice
LATTICE_CONTENT_DIR=content
LATTICE_SANDBOX_IMAGE_PYTHON=lattice-sandbox-python:dev
LATTICE_SESSION_TTL_HOURS=336
# Set to true behind HTTPS so session cookies are never sent in clear text.
LATTICE_SECURE_COOKIES=false
LATTICE_ATTEMPTS_PER_MINUTE=10
# Public origin of the site; certificate links and share previews use it.
LATTICE_PUBLIC_BASE_URL=http://localhost:8080
LATTICE_ALLOWED_ORIGINS=http://localhost:5173
LATTICE_LOG_LEVEL=INFO
# Production: run grading containers under gVisor (install runsc and register it with Docker).
# LATTICE_SANDBOX_OCI_RUNTIME=runsc
# Production under gVisor on a small VPS runs code several times slower; scale the time limits.
# LATTICE_SANDBOX_TIMEOUT_FACTOR=3

# Proxies whose CF-Connecting-IP / X-Forwarded-For headers are believed (comma-separated CIDRs).
# Production: the Docker network Caddy reaches the API from. Empty: the peer is the client.
LATTICE_TRUSTED_PROXIES=
# Email: "console" logs messages (development). Production: resend, with an API key and a sender
# on a domain verified in Resend.
LATTICE_EMAIL_PROVIDER=console
# LATTICE_RESEND_API_KEY=re_...
# LATTICE_EMAIL_FROM=Forgeway <hello@your-domain>
# Test stacks only: exposes the console outbox and the plan switch at /api/test/*. Honoured only
# with the console provider, so it can never be on where real email is sent.
# LATTICE_E2E=false
# Cloudflare Turnstile on register; off while the secret is unset.
# LATTICE_TURNSTILE_SITE_KEY=
# LATTICE_TURNSTILE_SECRET=
# Abuse limits (defaults shown).
LATTICE_REGISTER_PER_IP_PER_HOUR=10
LATTICE_LOGIN_PER_IP_PER_HOUR=60
LATTICE_LOGIN_PER_EMAIL_PER_HOUR=50
LATTICE_PASSWORD_RESET_PER_IP_PER_HOUR=10
LATTICE_PASSWORD_RESET_PER_EMAIL_PER_HOUR=3
LATTICE_VERIFICATION_EMAILS_PER_HOUR=3
LATTICE_ATTEMPTS_PER_DAY=200
# Sandbox seconds per account in any 24 hours, summed from graded attempts' recorded durations.
LATTICE_GRADING_SECONDS_PER_DAY=1800
LATTICE_MAX_QUEUE_DEPTH=50
# Account data exports, and deletion tries (per account, and per IP for deletion), an hour.
LATTICE_ACCOUNT_EXPORTS_PER_HOUR=5
LATTICE_ACCOUNT_DELETIONS_PER_HOUR=5
# The sandbox memory ceiling, whatever an exercise declares.
LATTICE_SANDBOX_MAX_MEMORY_MB=768
# The free plan: this many exercises of every track past the foundations (ADR 0011).
LATTICE_FREE_EXERCISES_PER_BRANCH=3
